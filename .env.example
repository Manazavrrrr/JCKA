# ---------------------------------------------------------------------------
# SAQ QURYLYS — пример конфигурации.
# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env
#
# Секретов и ключей в репозитории нет и быть не должно (.env в .gitignore).
# ---------------------------------------------------------------------------

# База данных. SQLite-файл создаётся локально командой npm run db:reset.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# ИИ-модуль
# ---------------------------------------------------------------------------
# rules — детерминированный разбор на правилах и словаре формулировок.
#         Работает полностью локально, без интернета и без ключей.
#         Это рабочий режим по умолчанию, а не заглушка: он разбирает
#         любой новый текст, а не заранее заготовленные примеры.
# llm   — разбор через внешнюю языковую модель. Ответ модели валидируется
#         Zod-схемой; при ошибке валидации система автоматически
#         возвращается к режиму rules, чтобы демонстрация не прерывалась.
AI_PROVIDER=rules

# Настройки для AI_PROVIDER=llm. Оставьте пустыми при работе в режиме rules.
# Поддерживается любой провайдер с OpenAI-совместимым API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Таймаут обращения к модели, мс. По истечении — переход в режим rules.
LLM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------
# Учётная запись аналитика для демонстрации. Авторизация в MVP не реализована,
# значение подставляется в поля «автор решения» журнала действий.
DEMO_ANALYST_ID=analyst@demo.local

# ---------------------------------------------------------------------------
# Сбор публикаций из Instagram (платный источник)
# ---------------------------------------------------------------------------
# Публикации застройщика в Instagram читаются сторонним сборщиком Apify —
# актором apify/instagram-scraper. Источник выключен по умолчанию, и это
# сознательно: у него две цены.
#
#   Деньги. 2,70 $ за 1000 результатов на бесплатном тарифе Apify (2,30 $ на
#   Starter, 1,90 $ на Scale, 1,50 $ на Business). Цена сверена 16.10.2026 на
#   странице актора; проверьте её перед запуском, тарифы меняются. Один прогон
#   не может запросить больше 100 публикаций, то есть дороже 27 центов один
#   прогон не выйдет — предел задан в ядре, а не в интерфейсе.
#
#   Условия площадки. Автоматическое чтение Instagram противоречит
#   пользовательскому соглашению Meta. Читаются только открытые публикации
#   коммерческих аккаунтов застройщиков; личные страницы граждан и закрытые
#   профили не читаются. Решение подключать источник принимает орган.
#
# Как завести ключ:
#   1. Зарегистрируйтесь на https://console.apify.com (бесплатный тариф даёт
#      стартовый кредит, карта на этом шаге не нужна).
#   2. Settings → API & Integrations → Personal API tokens → создайте токен.
#   3. Впишите его ниже строкой APIFY_TOKEN=apify_api_... и перезапустите
#      сервер. Ключ остаётся на сервере: в браузер уходит только булево
#      «задан или нет».
#
# Если ключа нет, источник не исчезает и прогон не падает: он выполняется на
# сохранённом образце ответа актора (src/core/collect/apify.fixture.ts), и
# прогон получает пометку о том, что живого сбора не было и запрошенный
# профиль прочитан не был. Выдать демонстрацию за живой сбор нельзя.
APIFY_TOKEN=

# ---------------------------------------------------------------------------
# Автоматический обход: сбор без нажатия кнопки
# ---------------------------------------------------------------------------
# До обхода программа отвечала на вопрос «что в этом аккаунте», но спросить
# должен был человек. Надзор так не работает: объявление с рассрочкой от
# неизвестной компании живёт в ленте несколько дней, и застать его можно,
# только если смотреть каждый день. Поэтому смотрит программа, а человек
# разбирает уже найденное.
#
# Обход ходит по словам, а не по перечню аккаунтов: перечень знает только тех,
# о ком уже известно, а искать надо как раз неизвестных. Слова задаются на
# экране «Сбор» и лежат в базе, а не здесь — их правит аналитик, не
# администратор.
#
# Выключено по умолчанию, и это сознательно: обход тратит деньги, а
# проверяющий, запустивший проект впервые, на это не подписывался. Не увидеть
# обход, который включается одной переменной, — неприятно; увидеть счёт за
# обход, которого не просили, — хуже.
#
# Принимается 1, true, on, да. Любое другое значение означает «выключено».
COLLECT_AUTO=

# Период обхода, минуты. По умолчанию 180. Значение приводится к отрезку от 15
# до 1440: период в одну минуту — это не частый обход, а способ израсходовать
# дневной предел за четверть часа и получить от Instagram ограничение по
# частоте запросов. Первый цикл выполняется не при старте, а через период:
# иначе сервер в режиме разработки платил бы за обход на каждой правке.
COLLECT_INTERVAL_MINUTES=180

# Дневной предел расхода на платный сбор, доллары. По умолчанию 0,50 $ —
# примерно 185 публикаций в сутки. Потолок 5,00 $ задан в ядре и переменной не
# снимается: предел, выставленный опечаткой в тысячу долларов, перестаёт быть
# пределом.
#
# Сутки считаются по местному времени (UTC+5, Казахстан), а не по UTC. Иначе
# обход в 01:00 по Усть-Каменогорску списывался бы со вчерашнего предела, и
# новые сутки начинались бы надкусанными.
#
# Предел проверяется перед каждым платным прогоном и действует одинаково на
# автоматический обход и на кнопку «Обойти сейчас»: нажать самому не должно
# быть способом обойти ограничение расхода. Прогон, не уместившийся в остаток,
# не урезается, а пропускается целиком — и записывается в историю со статусом
# SKIPPED и объяснением, чтобы молчащий обход не выглядел как «ничего не
# нашлось».
#
# Ноль означает «платный сбор выключен»: это решение, а не исчерпанный предел,
# и в интерфейсе они различимы.
COLLECT_DAILY_BUDGET_USD=0.50
